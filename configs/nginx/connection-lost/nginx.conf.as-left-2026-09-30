worker_processes 1;
daemon off;
error_log logs/error.log info;
pid logs/nginx.pid;
events { worker_connections 256; }
http {
  access_log logs/access.log;
  client_body_temp_path tmp/body; proxy_temp_path tmp/proxy; fastcgi_temp_path tmp/fcgi; uwsgi_temp_path tmp/uwsgi; scgi_temp_path tmp/scgi;
  upstream n8n { server 127.0.0.1:5690; }

  # A — the common copy-paste config: plain HTTP proxy, no Upgrade / Connection headers
  server {
    listen 8081;
    location / {
      proxy_pass http://n8n;
      proxy_set_header Host $host:$server_port;
    }
  }

  # B — WebSocket headers present, but Host is left at nginx's default ($proxy_host = the upstream name)
  server {
    listen 8082;
    location / {
      proxy_pass http://n8n;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header X-Forwarded-Host $host:$server_port;   # B-fix: Host still the upstream name
    }
  }

  # C — working config
  server {
    listen 8083;
    location / {
      proxy_pass http://n8n;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host:$server_port;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_read_timeout 3600s;
    }
  }

  # D — working headers, but an idle read timeout shorter than n8n's 60 s server ping
  server {
    listen 8084;
    location / {
      proxy_pass http://n8n;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host:$server_port;
      # proxy_read_timeout left at nginx's default (60s)
    }
  }
}
