# The environment our local reproductions ran with (n8n installed from npm, Node 24; no Docker).
# NODE_ENV=production matches the official n8n image's Dockerfile. Without it, some behaviour differs:
# for example the ERR_ERL_UNEXPECTED_X_FORWARDED_FOR message and the push Origin check only appear in production.
NODE_ENV=production
# Throwaway folder: n8n writes .n8n/config (the encryption key) and database.sqlite here.
N8N_USER_FOLDER=./n8n-home
# 5690 on 2026-09-30 (n8n 2.41.3), 5711 on 2026-10-01 (n8n 2.41.5); the README examples use n8n's default 5678.
N8N_PORT=5690
N8N_DIAGNOSTICS_ENABLED=false
