# n8n's own request-body limit, in MiB (default 16). Read only at startup: recreate the container after changing it.
# Tested on n8n 2.41.3 (2026-09-30) and 2.41.5 (2026-10-01): a 17 MiB JSON body to a Webhook node returned
# HTTP 500 {"code":0,"message":"There was a problem executing the workflow"} at the default, and 200 with this value.
# A proxy in front has its own limit: nginx client_max_body_size defaults to 1m (see configs/nginx/request-entity-too-large).
N8N_PAYLOAD_SIZE_MAX=32

# Files sent as multipart form-data use a separate limit (default 200 MiB); a 20 MiB file went through at the defaults.
# N8N_FORMDATA_FILE_SIZE_MAX=200
